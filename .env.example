# OmniFlow — environment reference. Copy to .env for local runs outside compose; compose sets all
# of these itself (see docker-compose.yml). Nothing here is a secret except where marked.
#
# Every service — required
CRDB_DSN=postgres://root@localhost:26257/omniflow?sslmode=disable   # required; a bare DSN wins over CRDB_STATEMENT_TIMEOUT
KAFKA_BROKERS=localhost:9092                                          # required (KAFKA_BOOTSTRAP is a deprecated alias)

# Every service — Kafka transport (internal/platform/kafkaconf). Plaintext when unset.
KAFKA_TLS=false                     # true = TLS with system roots
KAFKA_TLS_CA=                       # optional PEM bundle to trust
KAFKA_SASL_MECHANISM=               # PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 — requires KAFKA_TLS=true
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=                # SECRET

# Every service — bounds and telemetry (internal/platform/{crdbpool,retry,telemetry})
CRDB_STATEMENT_TIMEOUT=30s          # session statement_timeout
RETRY_MAX_ATTEMPTS=8                # in-place retries of a transient failure before dead-lettering
RETRY_INITIAL_BACKOFF=200ms
RETRY_MAX_BACKOFF=10s
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # json | text
OTEL_EXPORTER_OTLP_ENDPOINT=        # e.g. http://otel-collector:4318; empty = spans not exported
OTEL_SERVICE_VERSION=               # stamped on traces; defaults to the build's vcs revision

# commbot
LITELLM_URL=http://localhost:4000                                     # OpenAI-style /chat/completions gateway (mock-llm in CI)
LITELLM_KEY=                                                          # SECRET — bearer for the gateway; empty = no auth header
OBJECT_STORE_HOSTS=storage.googleapis.com,raw.githubusercontent.com   # SSRF allowlist for quarantine URIs; EMPTY = every email is terminal

# p2p-orchestrator (drafting agent + governance ceilings, all in micro-USD)
AGENT_MODEL=gemini-2.5-flash
AGENT_MAX_COST_PER_WORKFLOW_MICRO_USD=500000
AGENT_MAX_CALL_MICRO_USD=100000
AGENT_AUTONOMOUS_CEILING_MICRO_USD=50000000000
AGENT_RATE_RPS=2
AGENT_RATE_BURST=4
HITL_LEASE_TTL=24h                  # how long a workflow may wait at the human gate before the sweep fails it
HITL_SWEEP_INTERVAL=60s
HOSTNAME=                           # the pod/replica name written to workflows.owner_pod (set by Docker/Kubernetes)

# viz-gateway
# (DATABASE_URL is honoured as a deprecated alias of CRDB_DSN for this service)
VIZ_ALLOWED_ORIGINS=http://localhost:3000                             # CORS allowlist, comma-separated exact origins
VIZ_MAX_SSE_CLIENTS=100

# frontend (build-time; inlined into the bundle by `next build`)
NEXT_PUBLIC_API_BASE=http://localhost:8081

# tools/seed
SEED_MODE=outbox            # outbox | email | inventory
SEED_ACTION=full            # full | suspend-only | approve-only | inventory

# CockroachDB Enterprise license — OPTIONAL, multi-node clusters only; single-node runs changefeeds free
CRDB_LICENSE=               # SECRET
CRDB_ORG=
